{
  "opencollection": "1.0.0",
  "info": {
    "name": "DFlow Aggregator admin API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "admin",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "handler_health_check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://quote-api.dflow.net/health-check"
          }
        }
      ]
    }
  ],
  "bundled": true
}